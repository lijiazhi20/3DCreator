# Backend
DATABASE_URL=postgresql+asyncpg://3dcreator:3dcreator@localhost:5432/3dcreator
REDIS_URL=redis://localhost:6379/0
WORKER_SECRET=change-me-in-production

# Auth (API)
# DEV_AUTH_OFF=true  -> API accepts requests with no token (dev default).
# DEV_AUTH_OFF=false -> require `Authorization: Bearer <AUTH_TOKEN>` (prod).
# In dev this can be left unset. In prod set AUTH_TOKEN and DEV_AUTH_OFF=false.
AUTH_TOKEN=
DEV_AUTH_OFF=true

# Inference backend: "dev" (trimesh/pure-python fallback) or "gpu" (real models)
INFERENCE_BACKEND=dev

# Object Storage (Cloudflare R2 or AWS S3)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET=3dcreator-dev

# Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Worker
API_BASE=http://localhost:8000
