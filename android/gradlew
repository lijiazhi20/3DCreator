#!/bin/sh

#
# Copyright © 2015-2021 the original authors.
#
# Gradle start up script for POSIX generated by Gradle.
#
# This is a minimal, standard Gradle wrapper launcher. Android Studio regenerates
# gradle/wrapper/gradle-wrapper.jar on first sync; keep that jar in the repo for CI.

APP_HOME=$( cd "${0%/*}" >/dev/null 2>&1 && pwd )
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
  echo "Missing gradle/wrapper/gradle-wrapper.jar — run 'gradle wrapper' or open in Android Studio to generate it." >&2
  exit 1
fi

exec "$JAVA_HOME/bin/java" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
